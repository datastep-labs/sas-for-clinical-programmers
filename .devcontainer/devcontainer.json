{
  "name": "SAS for Clinical Programmers",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17" }
  },
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["datastep-labs.datastep-studio"],
      "settings": {
        "datastepStudio.python": "/usr/local/bin/python3"
      }
    },
    "codespaces": {
      "openFiles": ["START-HERE.md"]
    }
  }
}
