{
  "name": "SAS for Clinical Programmers",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": {
    "cpus": 2
  },
  "secrets": {
    "SAS_ODA_USER": {
      "description": "Optional. Your SAS OnDemand for Academics user ID, or the e-mail address you sign in with. With it and your home region, the connection is ready when the codespace opens: you only type your password.",
      "documentationUrl": "https://welcome.oda.sas.com"
    },
    "SAS_ODA_REGION": {
      "description": "Optional. Your SAS OnDemand home region: usw2, usw2-2, euw1, apse1 or apse1-2. It is in the web address of SAS Studio: odamid-euw1 means euw1. The address itself works too."
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "datastep-labs.datastep-studio",
        "-vscjava.vscode-java-pack",
        "-redhat.java",
        "-vscjava.vscode-gradle",
        "-vscjava.vscode-java-debug",
        "-vscjava.vscode-java-test",
        "-vscjava.vscode-maven",
        "-vscjava.vscode-java-dependency",
        "-ms-python.python",
        "-ms-python.vscode-pylance",
        "-ms-python.debugpy",
        "-ms-python.autopep8",
        "-ms-python.vscode-python-envs",
        "-dbaeumer.vscode-eslint"
      ],
      "settings": {
        "datastepStudio.python": "/usr/local/bin/python3",
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor"
        },
        "workbench.editor.empty.hint": "hidden",
        "chat.disableAIFeatures": true
      }
    },
    "codespaces": {
      "openFiles": [
        "START-HERE.md"
      ]
    }
  }
}
